# Manual booking and local parsing work without these optional AI settings.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Set via environment, not committed real credentials.
DEMO_PASSWORD=ChronoGrid2026!
COOKIE_SECURE=false
# Use distinct names for separate local apps/test servers on the same hostname.
AUTH_COOKIE_NAME=chronogrid_session
# Required for stateless session verification on Vercel/serverless hosts. Generate a long random value in the host; never commit it.
AUTH_SIGNING_SECRET=

# Explicit disposable-demo mode enables passwordless server-issued role switching.
DEMO_MODE=false
