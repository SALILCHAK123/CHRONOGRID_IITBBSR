  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "week": {
            "type": "integer",
            "const": 7,
            "title": "Week",
            "default": 7
          },
          "day": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Day"
          },
          "start_period": {
            "type": "integer",
            "maximum": 13.0,
            "minimum": 1.0,
            "title": "Start Period"
          },
          "duration": {
            "type": "integer",
            "maximum": 13.0,
            "minimum": 1.0,
            "title": "Duration"
          },
          "title": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Title"
          },
          "room": {
            "type": "string",
            "title": "Room"
          },
          "size": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Size"
          },
          "category": {
            "type": "string",
            "enum": [
              "institute",
              "guest",
              "department",
              "club"
            ],
            "title": "Category",
            "default": "club"
          },
          "room_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room Type"
          },
          "accessible": {
            "type": "boolean",
            "title": "Accessible",
            "default": false
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Groups"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "day",
          "start_period",
          "duration",
          "title",
          "room",
          "size"
        ],
        "title": "Booking"
      },
      "Disruption": {
        "properties": {
          "room_closures": {
            "items": {
              "$ref": "#/components/schemas/RoomClosure"
            },
            "type": "array",
            "title": "Room Closures"
          },
          "faculty_leave": {
            "items": {
              "$ref": "#/components/schemas/FacultyLeave"
            },
            "type": "array",
            "title": "Faculty Leave"
          },
          "added_sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array",
            "title": "Added Sessions"
          },
          "moves": {
            "items": {
              "$ref": "#/components/schemas/Move"
            },
            "type": "array",
            "title": "Moves"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Disruption"
      },
      "FacultyLeave": {
        "properties": {
          "week": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 7.0,
            "title": "Week",
            "default": 7
          },
          "day": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Day"
          },
          "start_period": {
            "type": "integer",
            "maximum": 13.0,
            "minimum": 1.0,
            "title": "Start Period"
          },
          "duration": {
            "type": "integer",
            "maximum": 13.0,
            "minimum": 1.0,
            "title": "Duration"
          },
          "faculty": {
            "type": "string",
            "title": "Faculty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "day",
          "start_period",
          "duration",
          "faculty"
        ],
        "title": "FacultyLeave"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Move": {
        "properties": {
          "session": {
            "type": "string",
            "title": "Session"
          },
          "day": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Day"
          },
          "start_period": {
            "type": "integer",
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Start Period"
          },
          "room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session",
          "day",
          "start_period"
        ],
        "title": "Move"
      },
